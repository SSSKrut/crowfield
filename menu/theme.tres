[gd_resource type="Theme" load_steps=5 format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 32.0
content_margin_top = 28.0
content_margin_right = 32.0
content_margin_bottom = 28.0
bg_color = Color(0.085, 0.12, 0.12, 0.98)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.26, 0.38, 0.36, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
shadow_color = Color(0, 0, 0, 0.35)
shadow_size = 14

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_primary_normal"]
bg_color = Color(0.21, 0.39, 0.34, 1)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_right = 5
corner_radius_bottom_left = 5

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_primary_hover"]
bg_color = Color(0.27, 0.47, 0.4, 1)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_right = 5
corner_radius_bottom_left = 5

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_primary_pressed"]
bg_color = Color(0.16, 0.31, 0.27, 1)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_right = 5
corner_radius_bottom_left = 5

[resource]
default_font_size = 18
PanelContainer/styles/panel = SubResource("StyleBoxFlat_panel")
PrimaryButton/base_type = &"Button"
PrimaryButton/styles/normal = SubResource("StyleBoxFlat_primary_normal")
PrimaryButton/styles/hover = SubResource("StyleBoxFlat_primary_hover")
PrimaryButton/styles/pressed = SubResource("StyleBoxFlat_primary_pressed")
