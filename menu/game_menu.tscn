[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://menu/game_menu.gd" id="1_menu"]
[ext_resource type="Theme" path="res://menu/theme.tres" id="2_theme"]
[ext_resource type="FontFile" path="res://assets/type/BarlowCondensed-Bold.ttf" id="3_display"]

[node name="GameMenu" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_menu")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.025, 0.04, 0.045, 0.52)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(292, 0)
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="Title" type="Label" parent="Center/Panel/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_fonts/font = ExtResource("3_display")
theme_override_font_sizes/font_size = 38
text = "Paused"

[node name="About" type="Label" parent="Center/Panel/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.78, 0.77, 1)
theme_override_font_sizes/font_size = 15
autowrap_mode = 3

[node name="Gap" type="Control" parent="Center/Panel/Rows"]
custom_minimum_size = Vector2(0, 6)
layout_mode = 2
mouse_filter = 2

[node name="Resume" type="Button" parent="Center/Panel/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Resume"
alignment = 0

[node name="Replay" type="Button" parent="Center/Panel/Rows"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
text = "Play again"
alignment = 0

[node name="ControlsButton" type="Button" parent="Center/Panel/Rows"]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
text = "Controls"
flat = true
alignment = 0

[node name="Controls" type="Label" parent="Center/Panel/Rows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.78, 0.77, 1)
theme_override_font_sizes/font_size = 15
text = "WASD Move  ·  Shift Sprint
Space Jump  ·  C Crouch
Mouse Fire / aim  ·  R Reload
1–7 Switch weapon"
autowrap_mode = 3

[node name="Leave" type="Button" parent="Center/Panel/Rows"]
layout_mode = 2
text = "Main menu"
flat = true
alignment = 0

[node name="Quit" type="Button" parent="Center/Panel/Rows"]
layout_mode = 2
text = "Quit game"
flat = true
alignment = 0

[connection signal="pressed" from="Center/Panel/Rows/Resume" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Center/Panel/Rows/Replay" to="." method="_on_replay_pressed"]
[connection signal="toggled" from="Center/Panel/Rows/ControlsButton" to="." method="_on_controls_toggled"]
[connection signal="pressed" from="Center/Panel/Rows/Leave" to="." method="_on_leave_pressed"]
[connection signal="pressed" from="Center/Panel/Rows/Quit" to="." method="_on_quit_pressed"]
